# shellcheck shell=bash
# shellcheck disable=SC2034
# Staging overrides — loaded AFTER secrets-common for `-d staging`.
# Only the four values that make it a separate bot + DB; the rest is shared.
# Same git-common-dir anchor as secrets-common (worktree-safe).
INFRA=$(dirname "$(git rev-parse --git-common-dir)")/../infra
STAGING_APP=cube-worlds-bot-staging
MONGO=$(sops -d --extract '["db_uri"]' "$INFRA/secrets/apps/$STAGING_APP.enc.yaml")
BOT_TOKEN=$(sops -d --extract '["bot_token"]' "$INFRA/secrets/apps/$STAGING_APP.enc.yaml")
BOT_WEBHOOK=https://staging.cubeworlds.club/telegram/webhook
BOT_WEBHOOK_SECRET=$(sops -d --extract '["bot_webhook_secret"]' "$INFRA/secrets/apps/$STAGING_APP.enc.yaml")
